// server/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ÇOK KİRACILI TEMEL
// ─────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("Europe/Istanbul")
  /// Kurum ayarları (JSON). Tipli okuma: server/src/lib/sharing.ts → getOrgSettings()
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  departments      Department[]
  teams            Team[]        @relation("OrgTeams")
  questionSets     QuestionSet[]
  assessments      Assessment[]
  personnel        Personnel[]
  questions        Question[]
  aiConfigs        AiConfig[]
  aiPromptTemplates AiPromptTemplate[]
  aiChatConversations AiChatConversation[]
  reviewCycles      ReviewCycle[]
}

// ─────────────────────────────────────────
// KULLANICI VE YETKİLENDİRME
// ─────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  HR_MANAGER
  ANALYST
  VIEWER
}

model User {
  id           String    @id @default(cuid())
  email        String
  password     String
  name         String
  role         UserRole  @default(VIEWER)
  isActive     Boolean   @default(true)
  refreshToken String?
  lastLoginAt  DateTime?
  deletedAt    DateTime?

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationId     String
  scopedDepartmentId String?

  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  /// Bizmo.ID bağlantısı: `externalId` = OIDC `sub`, `externalProvider` = "bizmo-id".
  /// Rol ve yetki HRPDR'de kalır; ad ve e-posta Bizmo.ID'den eşitlenir.
  externalId         String?
  externalProvider   String?
  /// Hesap Bizmo.ID olayıyla (işten çıkış, erişimin kaldırılması) pasiflendiyse dolu;
  /// yeniden açan olay yalnız bu durumda hesabı açar (yerelde pasiflenen hesaba dokunmaz).
  externalDisabledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdAssessments   Assessment[]         @relation("AssessmentCreator")
  createdQuestionSets  QuestionSet[]        @relation("QuestionSetCreator")
  generatedReports     Report[]             @relation("ReportGenerator")
  passwordResetTokens  PasswordResetToken[] @relation("AdminPasswordReset")
  notifications        Notification[]       @relation("UserNotifications")
  analysisReviews      AnalysisReview[]     @relation("AnalysisReviewer")
  aiChatConversations  AiChatConversation[]
  createdReviewCycles  ReviewCycle[]        @relation("ReviewCycleCreator")

  @@unique([organizationId, email])
  @@unique([externalProvider, externalId])
}

// ─────────────────────────────────────────
// ORGANİZASYON YAPISI
// ─────────────────────────────────────────

model Department {
  id          String    @id @default(cuid())
  name        String
  description String?
  color       String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  teams     Team[]
  personnel Personnel[]

  @@unique([organizationId, name])
}

model Team {
  id          String    @id @default(cuid())
  name        String
  description String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  department     Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId   String
  organization   Organization @relation("OrgTeams", fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  personnel Personnel[]
}

// ─────────────────────────────────────────
// PERSONEL
// ─────────────────────────────────────────

enum PersonnelStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  /// İşten ayrıldı: portal kapalı, kayıt salt okunur (geçmiş korunur)
  TERMINATED
}

enum PersonnelShift {
  NONE
  MORNING
  AFTERNOON
  NIGHT
  ROTATING
}

model Personnel {
  id             String          @id @default(cuid())
  employeeId     String
  firstName      String
  lastName       String
  email          String
  phone          String?
  position       String
  experienceYear Int             @default(0)
  status         PersonnelStatus @default(ACTIVE)
  shift          PersonnelShift  @default(NONE)
  preferredLanguage String       @default("tr")

  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  departmentId String?
  team         Team?       @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamId       String?

  // Org şeması (360° değerlendirici önerisi): doğrudan yönetici
  manager       Personnel?  @relation("PersonnelManager", fields: [managerId], references: [id], onDelete: SetNull)
  managerId     String?
  directReports Personnel[] @relation("PersonnelManager")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationId String

  hireDate   DateTime?
  birthDate  DateTime?
  notes      String?
  avatarUrl  String?

  /// İşten ayrılış (status = TERMINATED): tarih, neden kodu, serbest not
  terminationDate   DateTime?
  terminationReason String?
  terminationNote   String?

  portalPasswordHash String?  @map("portal_password_hash")
  portalRefreshToken String?
  lastPortalLogin    DateTime?

  /// Personel portalı Bizmo.ID bağlantısı (OIDC `sub`). İK verisi (ad, durum) Bizmo.ID'den yazılmaz.
  externalId       String? @map("external_id")
  externalProvider String? @map("external_provider")

  importSource String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assessmentSessions  AssessmentSession[]
  reports             Report[]
  consentRecords      ConsentRecord[]
  passwordResetTokens PasswordResetToken[] @relation("PersonnelPasswordReset")
  notifications       Notification[]       @relation("PersonnelNotifications")
  reviewSubjects      ReviewSubject[]      @relation("ReviewSubjectPersonnel")
  reviewAssignments   ReviewAssignment[]   @relation("ReviewAssignmentRater")
  careerPlans         CareerPlan[]

  @@unique([organizationId, employeeId])
  @@unique([organizationId, email])
  @@unique([externalProvider, externalId])
  @@index([organizationId])
  @@index([departmentId])
  @@index([managerId])
}

// ─────────────────────────────────────────
// SORU YÖNETİMİ
// ─────────────────────────────────────────

enum QuestionDimension {
  LOGICAL_ALGORITHMIC
  LEADERSHIP
  SOCIAL_INTELLIGENCE
  GROWTH_POTENTIAL
  DOMAIN_ALIGNMENT
}

enum QuestionType {
  OPEN_ENDED
  SITUATIONAL
  BEHAVIORAL
  SCALE
  MULTIPLE_CHOICE
}

enum QuestionPhase {
  ICEBREAKER
  CORE
  CLOSING
}

model Question {
  id             String            @id @default(cuid())
  text           String
  subText        String?
  dimension      QuestionDimension
  type           QuestionType
  phase          QuestionPhase
  weight         Float             @default(1.0)
  followUpPrompt String?
  options        Json?
  minScale       Int?
  maxScale       Int?
  isActive       Boolean           @default(true)
  isAiGenerated  Boolean           @default(false)
  aiModel        String?
  tags           String[]
  language       String            @default("tr")
  deletedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationId String

  questionSetItems QuestionSetItem[]
  answers          Answer[]

  @@index([organizationId, dimension])
}

model QuestionSet {
  id          String    @id @default(cuid())
  name        String
  description String?
  isActive    Boolean   @default(true)
  isDefault   Boolean   @default(false)
  version     Int       @default(1)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy   User   @relation("QuestionSetCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdById String

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationId String

  aiGenerationParams Json?

  weightLogical    Float @default(20)
  weightLeadership Float @default(20)
  weightSocial     Float @default(20)
  weightGrowth     Float @default(20)
  weightDomain     Float @default(20)

  items       QuestionSetItem[]
  assessments Assessment[]
  reviewCycles ReviewCycle[]

  @@index([organizationId])
}

model QuestionSetItem {
  id            String      @id @default(cuid())
  questionSet   QuestionSet @relation(fields: [questionSetId], references: [id], onDelete: Cascade)
  questionSetId String
  question      Question    @relation(fields: [questionId], references: [id], onDelete: Restrict)
  questionId    String
  order         Int
  isRequired    Boolean     @default(true)
  customWeight  Float?

  @@unique([questionSetId, questionId])
  @@unique([questionSetId, order])
}

// ─────────────────────────────────────────
// DEĞERLENDİRME VE TEST OTURUMU
// ─────────────────────────────────────────

enum AssessmentStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

model Assessment {
  id          String           @id @default(cuid())
  title       String
  description String?
  status      AssessmentStatus @default(DRAFT)

  questionSet   QuestionSet @relation(fields: [questionSetId], references: [id], onDelete: Restrict)
  questionSetId String

  createdBy   User   @relation("AssessmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdById String

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationId String

  startsAt  DateTime?
  endsAt    DateTime?

  /// Sonuçların personelle paylaşımı: null = kurum varsayılanı, true = paylaş, false = paylaşma
  shareWithEmployee Boolean?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  sessions AssessmentSession[]

  @@index([organizationId])
}

enum SessionStatus {
  NOT_STARTED
  IN_PROGRESS
  PAUSED
  COMPLETED
  EXPIRED
}

enum AnalysisPipelineStatus {
  NOT_QUEUED
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model AssessmentSession {
  id           String        @id @default(cuid())
  status       SessionStatus @default(NOT_STARTED)
  startedAt    DateTime?
  completedAt  DateTime?
  durationSec  Int?
  ipAddress    String?
  userAgent    String?

  dueAt              DateTime?
  reminderSentAt     DateTime?
  invitationToken    String?   @unique

  questionSetSnapshot Json?

  rawAnalysis      Json?
  dimensionScores  Json?
  swotAnalysis     Json?
  careerPaths      Json?
  keyInsights      String?
  analysisModel    String?
  analysisPipeline AnalysisPipelineStatus @default(NOT_QUEUED)
  analysisError    String?

  hrPdrAnalysis         Json?
  psychologicalAnalysis Json?

  requiresHrReview Boolean @default(true)

  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentId String

  personnel   Personnel @relation(fields: [personnelId], references: [id], onDelete: Restrict)
  personnelId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers        Answer[]
  report         Report?
  sessionEvents  SessionEvent[]
  analysisReview AnalysisReview?
  consentRecords ConsentRecord[]

  @@unique([assessmentId, personnelId])
  @@index([personnelId])
}

model Answer {
  id          String @id @default(cuid())
  textAnswer  String?
  scaleValue  Int?
  choiceKey   String?
  durationSec Int?

  aiScore        Float?
  aiSignals      Json?
  followUpAsked  Boolean @default(false)
  followUpAnswer String?

  clientDedupeKey String?

  session    AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId  String
  question   Question          @relation(fields: [questionId], references: [id], onDelete: Restrict)
  questionId String

  answeredAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([sessionId, questionId])
  @@unique([sessionId, clientDedupeKey])
}

// ─────────────────────────────────────────
// RAPORLAMA
// ─────────────────────────────────────────

enum ReportStatus {
  GENERATING
  READY
  FAILED
}

model Report {
  id               String       @id @default(cuid())
  status           ReportStatus @default(GENERATING)
  executiveSummary String?
  fullReportJson   Json?
  pdfUrl           String?
  generatedAt      DateTime?
  createdAt        DateTime     @default(now())

  session    AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId  String            @unique

  personnel   Personnel @relation(fields: [personnelId], references: [id], onDelete: Restrict)
  personnelId String

  generatedBy   User?   @relation("ReportGenerator", fields: [generatedById], references: [id], onDelete: SetNull)
  generatedById String?
}

// ─────────────────────────────────────────
// KVKK / AÇIK RIZA
// ─────────────────────────────────────────

model ConsentRecord {
  id               String   @id @default(cuid())
  consentType      String
  legalTextVersion String
  accepted         Boolean
  acceptedAt       DateTime
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime @default(now())

  personnel   Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  personnelId String

  session   AssessmentSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  sessionId String?

  @@index([personnelId])
}

// ─────────────────────────────────────────
// ŞİFRE SIFIRLAMA
// ─────────────────────────────────────────

// ─────────────────────────────────────────
// BİZMO.ID (OIDC TEK GİRİŞ, SCIM)
// ─────────────────────────────────────────

/// Tek kullanımlık Bizmo.ID giriş akışı. `state` ile başlar (10 dk), callback'te tüketilir;
/// ardından uygulamaya tek kullanımlık devir kodu (`handoff`, 60 sn) verilir. Değerler
/// yalnız SHA-256 özetiyle aranır; akış başlatan tarayıcıya httpOnly çerezle bağlıdır.
model SsoLoginFlow {
  id           String   @id @default(cuid())
  stateHash    String   @unique
  bindingHash  String
  nonce        String
  codeVerifier String
  /// "admin" (yönetim paneli) veya "portal" (personel portalı)
  app          String
  returnTo     String
  rememberMe   Boolean  @default(false)
  expiresAt    DateTime

  handoffHash String?  @unique
  /// Eşlenen User.id (admin) veya Personnel.id (portal)
  subjectId   String?
  /// Bizmo.ID çıkışında id_token_hint için (devirde httpOnly çereze taşınır, satır silinir)
  idToken     String?
  authMeta    Json?
  createdAt   DateTime @default(now())

  @@index([expiresAt])
}

/// SCIM 2.0 ile Bizmo.ID'nin gönderdiği kişiler (yerel dizin kopyası). `id` SCIM kaynak kimliğidir.
/// Bu tablo hesap açmaz: yalnız var olan kullanıcı/personele bağlanır ve onları günceller.
model BizmoIdIdentity {
  id             String   @id @default(cuid())
  externalId     String   @unique
  userName       String
  email          String?
  givenName      String?
  familyName     String?
  displayName    String?
  employeeNumber String?
  active         Boolean  @default(true)
  /// Son alınan SCIM kaynağı (şemalar ve uzantılarla)
  resource       Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userName])
  @@index([email])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  adminUser   User?      @relation("AdminPasswordReset", fields: [adminUserId], references: [id], onDelete: Cascade)
  adminUserId String?

  personnel   Personnel? @relation("PersonnelPasswordReset", fields: [personnelId], references: [id], onDelete: Cascade)
  personnelId String?

  @@index([expiresAt])
}

// ─────────────────────────────────────────
// İK ONAYI
// ─────────────────────────────────────────

enum AnalysisReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model AnalysisReview {
  id        String               @id @default(cuid())
  status    AnalysisReviewStatus @default(PENDING)
  comment   String?
  decidedAt DateTime?
  overrides Json?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  session    AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId  String            @unique

  reviewer   User   @relation("AnalysisReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewerId String
}

// ─────────────────────────────────────────
// OTURUM OLAYLARI
// ─────────────────────────────────────────

enum SessionEventType {
  SESSION_CREATED
  SESSION_STARTED
  ANSWER_SAVED
  FOLLOWUP_REQUESTED
  SESSION_PAUSED
  SESSION_RESUMED
  SESSION_COMPLETED
  ANALYSIS_QUEUED
  ANALYSIS_COMPLETED
  ANALYSIS_FAILED
  REPORT_QUEUED
  REPORT_READY
}

model SessionEvent {
  id        String           @id @default(cuid())
  type      SessionEventType
  payload   Json?
  createdAt DateTime         @default(now())

  session   AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String

  @@index([sessionId, createdAt])
}

// ─────────────────────────────────────────
// BİLDİRİMLER
// ─────────────────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  type      String
  title     String
  body      String?
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime  @default(now())

  user   User?   @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  personnel   Personnel? @relation("PersonnelNotifications", fields: [personnelId], references: [id], onDelete: Cascade)
  personnelId String?

  @@index([userId, readAt])
  @@index([personnelId, readAt])
}

// ─────────────────────────────────────────
// AI YAPILANDIRMASI VE KULLANIM
// ─────────────────────────────────────────

enum AiPromptType {
  HR_PDR_ANALYSIS
  PSYCHOLOGICAL_ANALYSIS
}

enum AiProvider {
  CLAUDE
  OPENAI
  GEMINI
  ABACUS
}

model AiConfig {
  id              String     @id @default(cuid())
  provider        AiProvider
  modelName       String
  encryptedApiKey String
  isActive        Boolean    @default(false)
  isDefault       Boolean    @default(false)
  purpose         String
  config          Json?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?
}

model AiPromptTemplate {
  id          String       @id @default(cuid())
  type        AiPromptType
  name        String
  systemPrompt String      @db.Text
  isActive    Boolean      @default(true)
  isDefault   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?

  @@index([organizationId, type])
}

model AiChatConversation {
  id        String   @id @default(cuid())
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  messages AiChatMessage[]

  @@index([organizationId])
  @@index([userId])
}

model AiChatMessage {
  id        String   @id @default(cuid())
  role      String // "user" | "assistant"
  content   String   @db.Text
  metadata  Json?
  createdAt DateTime @default(now())

  conversation   AiChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  @@index([conversationId])
}

model AiUsageLog {
  id           String     @id @default(cuid())
  provider     AiProvider
  modelName    String
  purpose      String
  inputTokens  Int?
  outputTokens Int?
  costUsd      Decimal?   @db.Decimal(12, 6)
  latencyMs    Int?
  requestType  String
  status       String
  errorCode    String?
  sessionId    String?
  userId       String?
  organizationId String?
  metadata     Json?
  createdAt    DateTime   @default(now())

  @@index([createdAt])
  @@index([sessionId])
  @@index([organizationId, createdAt])
}

// ─────────────────────────────────────────
// SİSTEM LOGU
// ─────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  before    Json?
  after     Json?
  ipAddress String?
  userAgent String?
  traceId   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

// ─── 360° değerlendirme ───
// Çok değerlendiricili, dönemsel değerlendirme. HR/PDR akışından (Assessment /
// AssessmentSession) bağımsızdır. Değerlendiriciler de Personnel kaydıdır ve
// personel portalından girer.

enum ReviewFrequency {
  ANNUAL
  SEMI_ANNUAL
  QUARTERLY
  ADHOC
}

enum ReviewCycleStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum ReviewRelation {
  SELF
  MANAGER
  PEER
  SUBORDINATE
}

enum ReviewSubjectStatus {
  OPEN
  CLOSED
  RELEASED
}

enum ReviewAssignmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DECLINED
}

model ReviewCycle {
  id          String            @id @default(cuid())
  name        String
  description String?
  frequency   ReviewFrequency   @default(ADHOC)
  status      ReviewCycleStatus @default(DRAFT)
  periodStart DateTime?
  periodEnd   DateTime?
  dueAt       DateTime?

  /// Grup ağırlıkları: { SELF, MANAGER, PEER, SUBORDINATE } (0–100)
  raterWeights       Json
  /// Eş düzey ve ast grupları en az bu kadar tamamlanmış değerlendirici varsa gösterilir
  anonymityMinRaters Int      @default(3)
  includeSelf        Boolean  @default(true)
  /// null = sistem varsayılanı (Organization.settings); paylaşım mantığı ayrı modülde
  shareWithEmployee  Boolean?

  questionSet         QuestionSet @relation(fields: [questionSetId], references: [id], onDelete: Restrict)
  questionSetId       String
  /// Dönem başlatılınca dondurulan form (QuestionSetSnapshot)
  questionSetSnapshot Json?

  createdBy   User   @relation("ReviewCycleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdById String

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationId String

  activatedAt DateTime?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  subjects ReviewSubject[]

  @@index([organizationId, status])
}

model ReviewSubject {
  id     String              @id @default(cuid())
  status ReviewSubjectStatus @default(OPEN)

  cycle   ReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  cycleId String

  /// Değerlendirilen kişi
  personnel   Personnel @relation("ReviewSubjectPersonnel", fields: [personnelId], references: [id], onDelete: Restrict)
  personnelId String

  releasedAt   DateTime?
  releasedById String?
  /// Dönem kapanınca dondurulan anonim özet (SubjectResultSummary)
  resultJson   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments ReviewAssignment[]

  @@unique([cycleId, personnelId])
  @@index([personnelId])
}

model ReviewAssignment {
  id       String                 @id @default(cuid())
  relation ReviewRelation
  status   ReviewAssignmentStatus @default(NOT_STARTED)

  subject   ReviewSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String

  rater            Personnel @relation("ReviewAssignmentRater", fields: [raterPersonnelId], references: [id], onDelete: Restrict)
  raterPersonnelId String

  startedAt      DateTime?
  completedAt    DateTime?
  declinedAt     DateTime?
  reminderSentAt DateTime?
  reminderCount  Int       @default(0)

  /// Değerlendirici başladığında dönemin formundan kopyalanır
  questionSetSnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers ReviewAnswer[]

  @@unique([subjectId, raterPersonnelId])
  @@index([raterPersonnelId, status])
}

model ReviewAnswer {
  id          String  @id @default(cuid())
  /// Form anlık görüntüsündeki soru kimliği
  questionId  String
  scaleValue  Int?
  choiceKey   String?
  textAnswer  String?
  durationSec Int?

  assignment   ReviewAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId String

  answeredAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([assignmentId, questionId])
}

// ─── Kariyer planı ───
// AI önerir, İK karar verir: öneri (aiSuggestion) yalnızca İK onaylı ve AI rızalı
// değerlendirmelerden üretilir; İK taslağa alır, düzenler ve onaylar.
// Her plan bir sürümdür (version); yeni sürüm onaylanınca önceki onaylı plan arşivlenir.

enum CareerPlanStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

model CareerPlan {
  id             String           @id @default(cuid())
  personnel      Personnel        @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  personnelId    String
  /// Kiracı yalıtımı: her sorgu organizationId ile filtrelenir
  organizationId String
  status         CareerPlanStatus @default(DRAFT)
  targetRole     String?
  horizonMonths  Int              @default(12)
  /// Sıralı adımlar: [{ id, title, type: TRAINING|MENTORING|PROJECT|ROLE|OTHER, targetDate, status: TODO|IN_PROGRESS|DONE, note }]
  steps          Json             @default("[]")
  /// Son AI önerisi (önizleme); İK "Taslağa al" deyince adımlara kopyalanır
  aiSuggestion   Json?
  aiModel        String?
  aiSuggestedAt  DateTime?
  /// Öneride kullanılan kaynaklar (oturum kimlikleri, değerlendirme adları, tarihler)
  sourceSummary  Json?
  /// null: kurum varsayılanı (paylaşım mantığı ayrı modülde)
  shareWithEmployee Boolean?
  version        Int              @default(1)
  /// Bu sürümün kopyalandığı önceki sürüm
  basedOnVersion Int?
  createdById    String?
  approvedById   String?
  approvedAt     DateTime?
  archivedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([personnelId, version])
  @@index([organizationId, personnelId])
}
